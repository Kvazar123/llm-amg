{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/skills/amg-bootstrap/scripts/lifecycle.py session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/skills/amg-bootstrap/scripts/lifecycle.py session-end",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/skills/amg-bootstrap/scripts/lifecycle.py prompt-hint",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
